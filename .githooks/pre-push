#!/usr/bin/env bash
# Security gate on every push: refuses a direct push to (or deletion of) main
# and a non-fast-forward push, and scans every commit the push would publish
# for secrets and blocked files (catches commits made with --no-verify or from
# a clone without hooks). Logic: .githooks/_security.sh; repo values:
# .githooks/security.conf. Install: scripts/install-githooks.sh
set -euo pipefail
# shellcheck source=SCRIPTDIR/_security.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_security.sh"

remote_name="${1:-origin}"
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "$local_ref" ]] || continue
  sec_pre_push_ref "$remote_name" "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || fail=1
done
sec_pre_push_finish || fail=1
exit "$fail"
