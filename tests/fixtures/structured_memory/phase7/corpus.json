    },
    {
      "id": "cross-owner-source",
      "class": "cross_owner",
      "owner": "user_alice",
      "episode_summary": "Alice-only episode about local fixtures.",
      "supported": false,
      "sensitive": false,
      "fixture_model": {
        "candidates": [
          {
            "action": "add",
            "content": "Should not bind a foreign episode source.",
            "category": "pref",
            "confidence": 0.4,
            "uncertainty": "",
            "sensitivity": "normal",
            "source_refs": ["{{foreign_id}}"]
          }
        ]
      },
      "expect": {
        "bind": "reject",
        "retain_proposal": false
      }
    }
  ],
  "recall_queries": [
    {
      "id": "useful-metric",
      "owner": "user_alice",
      "query": "metric units",
      "top_k": 4,
      "seed_facts": [
        {
          "label": "pref-metric",
          "owner": "user_alice",
          "content": "Prefer metric units in examples.",
          "category": "pref",
          "active": true
        },
        {
          "label": "stale-imperial",
          "owner": "user_alice",
          "content": "Prefer imperial units in examples.",
          "category": "pref",
          "active": false
        },
        {
          "label": "style-spaces",
          "owner": "user_alice",
          "content": "Prefer spaces in fixtures.",
          "category": "style",
          "active": true
        },
        {
          "label": "bob-metric",
          "owner": "user_bob",
          "content": "Prefer metric units in examples.",
          "category": "pref",
          "active": true
        }
      ],
      "relevant": ["pref-metric"],
      "forbidden": ["stale-imperial", "bob-metric"]
    },
    {
      "id": "stale-imperial-must-not-hit",
      "owner": "user_alice",
      "query": "imperial units",
      "top_k": 4,
      "seed_facts": [
        {
          "label": "pref-metric",
          "owner": "user_alice",
          "content": "Prefer metric units in examples.",
          "category": "pref",
          "active": true
        },
        {
          "label": "stale-imperial",
          "owner": "user_alice",
          "content": "Prefer imperial units in examples.",
          "category": "pref",
          "active": false
        }
      ],
      "relevant": [],
      "forbidden": ["stale-imperial"]
    },
    {
      "id": "cross-owner-search",
      "owner": "user_alice",
      "query": "bob private note",
      "top_k": 4,
      "seed_facts": [
        {
          "label": "bob-private",
          "owner": "user_bob",
          "content": "bob private note stays owner scoped.",
          "category": "pref",
          "active": true
        }
      ],
      "relevant": [],
      "forbidden": ["bob-private"]
    }
  ],
  "prompt_budget": {
    "pinned_char": "N",
    "pinned_repeat": 2000,
    "fact_char": "F",
    "fact_repeat": 800,
    "fact_count": 4
  },
  "pruning": {
    "owner": "user_alice",
    "max_episodes_per_owner": 2
  }
}
