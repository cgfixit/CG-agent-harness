            "source_refs": ["{{episode_id}}"]
          }
        ]
      },
      "expect": {
        "bind": "accept_or_reject",
        "retain_proposal": false
      }
    },
    {
      "id": "unsupported-paris",
      "class": "unsupported_hallucination",
      "owner": "user_alice",
      "episode_summary": "Operator prefers metric units in examples.",
      "supported": false,
      "sensitive": false,
      "fixture_model": {
        "candidates": [
          {
            "action": "add",
