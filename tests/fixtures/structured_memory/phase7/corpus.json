    {
      "id": "conflict-imperial-update",
      "class": "conflicting_facts",
      "owner": "user_alice",
      "episode_summary": "Operator now prefers metric units, replacing an earlier imperial preference.",
      "seed_facts": [
        {
          "label": "pref-imperial",
          "content": "Prefer imperial units in examples.",
          "category": "pref"
        }
      ],
      "supported": true,
      "sensitive": false,
      "fixture_model": {
        "candidates": [
          {
            "action": "update",
            "target_fact_id": "{{fact:pref-imperial}}",
            "content": "Prefer metric units in examples; imperial is stale.",
            "category": "pref",
            "confidence": 0.7,
            "uncertainty": "",
            "sensitivity": "normal",
            "source_refs": ["{{episode_id}}"]
          }
        ]
      },
      "expect": {
        "bind": "accept",
        "action": "update",
        "retain_proposal": true
