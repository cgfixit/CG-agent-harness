{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CG Agent Harness",
  "version": "0.1.0",
  "identifier": "com.cgfixit.agent-harness",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["setup"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0", "hardenedRuntime": true, "signingIdentity": "-" }
  }
}
