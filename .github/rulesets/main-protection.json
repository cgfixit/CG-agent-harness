{
  "name": "main: CI-gated squash merges through the merge queue",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "rustfmt", "integration_id": 15368 },
          { "context": "clippy (-D warnings)", "integration_id": 15368 },
          { "context": "test (ubuntu-latest)", "integration_id": 15368 },
          { "context": "test (macos-latest)", "integration_id": 15368 },
          { "context": "test (windows-latest)", "integration_id": 15368 },
          { "context": "Linux bubblewrap confinement (required)", "integration_id": 15368 },
          { "context": "Linux MCP service lifecycle (required)", "integration_id": 15368 },
          { "context": "Windows MCP Job Object lifecycle (required)", "integration_id": 15368 },
          { "context": "invariant guard (I6 source scan)", "integration_id": 15368 },
          { "context": "bakeoff harness self-test (fake Ollama)", "integration_id": 15368 },
          { "context": "cargo deny (advisories, licenses, bans)", "integration_id": 15368 },
          { "context": "chat slash-command browser acceptance", "integration_id": 15368 }
        ]
      }
    },
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 5,
        "max_entries_to_merge": 5,
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 5,
        "check_response_timeout_minutes": 60
      }
    }
  ]
}
