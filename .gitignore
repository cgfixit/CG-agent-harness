# ── Cargo / rustc ─────────────────────────────────────────────
# Unanchored target/ covers the workspace root and member crates
# built standalone (e.g. cd desktop && cargo build).
target/
debug/
**/*.rs.bk
*.pdb
**/mutants.out*/
# ── Desktop packaging + local dist ────────────────────────────
/desktop/gen/
/dist/
/upstream/
# ── Fine-tune artifacts from docs/FINETUNE.md (repo-root only) ─
/adapters/
/cgagent-fused/
/.venv/
# ── In-tree Python scripts ────────────────────────────────────
__pycache__/
**pycache**/
*.pyc
# ── OS / editor ───────────────────────────────────────────────
.DS_Store
*~
*.swp
.idea/
# ── Logs by extension (does not cover .jsonl — see below) ─────
*.log
# ── Named default home + any sessions/ dir, incl. test homes ──
.CGagentHarness/
sessions/
.env
.env.*
!.env.example
# ── Operator-home spill ───────────────────────────────────────
# If CGAGENTHARNESS_HOME is the checkout root. Default
# ~/.CGagentHarness is already outside git, and a home named
# .CGagentHarness is ignored anywhere. The runtime directories are
# anchored so a source directory with the same name (docs/memory/,
# a future src/**/tools/) is never silently ignored. A home in any
# other checkout subdirectory is not covered: keep it outside the
# checkout. Do not git add -f any of these.
/attachments/
notes_corpus/
/exports/
/memory/
/logs/
/tmp/
/tools/
tls/
soul-history/
harness.json
soul.md
soul-pending-apply.json
auth.json
auth.sqlite3
auth.initialized
cli-session.json
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# ── Agent artifacts under the tracked data/ prefix ────────────
# Keep data/styles/ tracked.
/data/agentic/
