{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo run -- serve:*)",
      "Bash(scripts/verify-local.sh:*)",
      "Bash(scripts/check-pr-template.sh:*)",
      "Bash(python3 scripts/test-desktop-backend.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "statusMessage": "Preparing Rust toolchain, libdbus and build cache..."
          }
        ]
      }
    ]
  }
}
